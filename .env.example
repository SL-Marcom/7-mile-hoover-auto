# Copy to .env.local and fill in real values once approved.
# Never commit .env.local — it's already covered by the .env* rule in .gitignore.

# Resend API key (https://resend.com) used to send Contact/Get Free Quote
# form submissions. Required for src/lib/forms/sendContactEmail.ts.
RESEND_API_KEY=

# Mailbox that should receive contact-form submissions (the shop's inbox).
CONTACT_TO_EMAIL=

# Verified sending address/domain in Resend that submissions are sent from.
CONTACT_FROM_EMAIL=
